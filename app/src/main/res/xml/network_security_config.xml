<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Certificates: system authorities, and those the user installed on the phone for a
     self-hosted server with a private authority. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
